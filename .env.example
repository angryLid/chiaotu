# Environment variables for the Vercel Edge Functions (api/ directory).
# Copy to .env and fill in; also set these in the Vercel project dashboard.

# shared API bearer token (same contract as the old friend-cats Go server)
API_TOKEN=your-api-token-here

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Supabase service_role key (server-side secret; bypasses RLS). Never expose to
# the browser. Supabase's current name for this is SUPABASE_SECRET_KEY.
# (Supabase also exposes SUPABASE_PUBLISHABLE_KEY = the anon key, not used here.)
SUPABASE_SECRET_KEY=